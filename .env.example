# Genera el .env con contraseñas aleatorias (solo requiere Docker):
#   docker compose -f compose.setup.yml run --rm init-env
# El archivo .env está excluido de Git. No pegues aquí credenciales de producción.

# Entorno: demo | test | production
APP_ENV=demo
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=tiendas
POSTGRES_SUPERUSER=postgres_admin
# Contraseñas: mínimo 24 caracteres aleatorios, solo letras, números, guion y guion bajo.
POSTGRES_SUPERUSER_PASSWORD=
APP_MIGRATOR_DB_PASSWORD=
APP_RUNTIME_DB_PASSWORD=
APP_PLATFORM_DB_PASSWORD=

# Puertos publicados solo en 127.0.0.1
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000
PANEL_HOST_PORT=8080
MAILPIT_UI_HOST_PORT=8025
